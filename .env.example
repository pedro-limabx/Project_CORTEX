NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://cortex:cortex@localhost:5432/cortex

# true = provider determinístico local; false = LLM externo
LOCAL_TEST_MODE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

CORS_ORIGIN=http://localhost:5173

# Optional in development; required when NODE_ENV=production. Use a random secret of at least 32 characters.
CORTEX_API_TOKEN=
# Server-controlled identity for this single-user deployment.
CORTEX_USER_ID=local-user

# V18 Google Calendar OAuth (optional, read-only). Do not commit real secrets.
# Set CORTEX_API_TOKEN before activating OAuth, even in development.
# Create "Web application" credentials in Google Cloud Console.
# Redirect URI must exactly match the HTTPS callback of the current Codespace
# or http://localhost:3000/api/integrations/google-calendar/callback.
# Keep Codespaces port visibility PRIVATE. Never make port 3000 public.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Generate one permanent 32-byte hex key: openssl rand -hex 32
# Changing it will invalidate previously saved Google tokens.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
